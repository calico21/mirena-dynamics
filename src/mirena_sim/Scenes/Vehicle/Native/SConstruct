#!/usr/bin/env python3
"""
SConstruct build file for TeR26 Native C++20 Multibody Vehicle Dynamics Engine & GDExtension.
Delegates to CMake or SCons depending on host toolchain availability.
"""
import os
import subprocess

env = Environment() if "Environment" in globals() else None
if env is not None:
    env.Append(CXXFLAGS=["-std=c++20", "-O3", "-fPIC", "-Iinclude", "-Igenerated/symforce", "-I/usr/include/eigen3"])
else:
    subprocess.run(["cmake", "-B", "build", "-S", "."], check=True)
    subprocess.run(["cmake", "--build", "build", "-j"], check=True)
