<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mirena_perception</name>
  <version>0.0.1</version>
  <description>Colourless LiDAR-only cone detection: Patchwork++ ground removal and PCL clustering</description>
  <maintainer email="ozuba@ozuba.es">Ozuba</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>pcl_conversions</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>mirena_common</depend>

  <!-- Patchwork++ has no package anywhere and is vendored by CMake at configure
       time; everything else above is an apt install away. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
