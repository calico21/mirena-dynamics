<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mirena_planning</name>
  <version>0.0.1</version>
  <description>Track planning for the Mirena Project. Turns the SLAM cone map into the centreline the controller follows: Delaunay triangulation on unknown tracks, registration of a surveyed template on known ones.</description>
  <maintainer email="miguelozubas@gmail.com">ozuba</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>mirena_common</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
